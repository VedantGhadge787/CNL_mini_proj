# Copy this file to .env and adjust values before running.
# Never commit .env — it is gitignored.

# Port the SMTP server listens on (non-privileged; default 2525)
SMTP_PORT=2525

# Port the POP3 server listens on (non-privileged; default 2110)
POP3_PORT=2110

# The local domain handled by this server (users@LOCAL_DOMAIN get local delivery)
LOCAL_DOMAIN=localhost

# Root directory for runtime data (mailboxes, SQLite DB, logs)
DATA_DIR=data

# Spam score threshold — messages scoring >= this value are flagged as spam
SPAM_THRESHOLD=5

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
